# Project environment variables example

# Environment
ENV=development
DEBUG=true
PROJECT_NAME="Bus Ticket Booking System API"

# Security & JWT
JWT_SECRET_KEY=supersecretjwtkeythatisextremelysecureandthirtytwobyteslong
JWT_REFRESH_SECRET_KEY=anothersecrethalfthatisalsoextremelysecureandthirtytwobyteslong
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bus_booking
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bus_booking

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
